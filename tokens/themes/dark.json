      "$type": "color",
      "$value": "#111827"
    },
    "secondary": {
      "$type": "color",
      "$value": "#1F2937"
    },
    "subtle": {
      "$type": "color",
      "$value": "color-mix(in srgb, #111827 88%, {color.lavender})"
    }
  },
  "surface": {
    "primary": {
      "$type": "color",
      "$value": "#1F2937"
    },
    "secondary": {
      "$type": "color",
      "$value": "#263244"
    },
    "elevated": {
      "$type": "color",
      "$value": "#2B374A"
    }
  },
  "text": {
    "primary": {
      "$type": "color",
      "$value": "#F9FAFB"
