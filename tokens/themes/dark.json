      "background": {
        "$type": "color",
        "$value": "{color.lavender}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.ink}"
      },
      "hover": {
        "$type": "color",
        "$value": "{color.cloudBlue}"
      }
    }
  },
  "focus": {
    "ring": {
      "$type": "color",
      "$value": "{color.cloudBlue}"
    }
  },
  "selection": {
    "background": {
      "$type": "color",
      "$value": "{color.lavender}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.ink}"
    }
  },
  "shadow": {
    "small": {
      "$type": "shadow",
      "$value": "0 2px 8px rgb(0 0 0 / 24%)"
    },
    "medium": {
      "$type": "shadow",
      "$value": "0 8px 24px rgb(0 0 0 / 32%)"
