{
  "theme": {
    "name": "dark"
  },
  "background": {
    "primary": {
      "$type": "color",
      "$value": "#111827"
    },
    "secondary": {
      "$type": "color",
      "$value": "#1F2937"
    },
    "subtle": {
      "$type": "color",
      "$value": "color-mix(in srgb, #111827 88%, {color.lavender})"
    }
  },
  "surface": {
    "primary": {
      "$type": "color",
      "$value": "#1F2937"
    },
    "secondary": {
      "$type": "color",
      "$value": "#263244"
    },
    "elevated": {
      "$type": "color",
      "$value": "#2B374A"
    }
  },
  "text": {
    "primary": {
      "$type": "color",
      "$value": "#F9FAFB"
    },
    "secondary": {
      "$type": "color",
      "$value": "#D1D5DB"
    },
    "muted": {
      "$type": "color",
      "$value": "#9CA3AF"
    },
    "inverse": {
      "$type": "color",
      "$value": "{color.ink}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.lavender}"
    }
  },
  "border": {
    "default": {
      "$type": "color",
      "$value": "#374151"
    },
    "subtle": {
      "$type": "color",
      "$value": "rgb(209 213 219 / 12%)"
    },
    "strong": {
      "$type": "color",
      "$value": "rgb(209 213 219 / 28%)"
    }
  },
