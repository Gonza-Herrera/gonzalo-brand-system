        "ringWidth": {
          "$type": "dimension",
          "$value": "{borderWidth.focus}"
        },
        "ringOffset": {
          "$type": "dimension",
          "$value": "{spacing.xs}"
        },
        "shadow": {
          "$type": "shadow",
          "$value": "0 0 0 {borderWidth.focus} {focus.ring}"
