      "borderWidth": {
        "$type": "dimension",
        "$value": "{borderWidth.default}"
      },
      "borderHighlight": {
        "$type": "color",
        "$value": "{glass.highlight.subtle}"
      },
      "backdropFilter": {
        "$type": "string",
        "$value": "blur({glass.blur.xs}) saturate({glass.saturation.subtle})"
