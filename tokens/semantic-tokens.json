      "borderWidth": {
        "$type": "dimension",
        "$value": "{borderWidth.default}"
      },
      "borderHighlight": {
        "$type": "color",
        "$value": "{glass.highlight.subtle}"
      },
      "backdropFilter": {
        "$type": "string",
        "$value": "none"
      },
      "shadow": {
        "$type": "shadow",
        "$value": "{shadowPrimitive.none}"
      },
      "innerShadow": {
        "$type": "shadow",
        "$value": "{glass.innerShadow.none}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{text.primary}"
      },
      "mutedForeground": {
        "$type": "color",
        "$value": "{text.secondary}"
