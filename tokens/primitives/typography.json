{
  "fontFamily": {
    "display": {
      "$type": "fontFamily",
      "$value": "'Manrope', system-ui, sans-serif"
    },
    "body": {
      "$type": "fontFamily",
      "$value": "'Inter', system-ui, sans-serif"
    }
  },
  "fontSize": {
    "hero": {
      "$type": "dimension",
      "$value": "4rem"
    },
    "h1": {
      "$type": "dimension",
      "$value": "3rem"
    },
    "h2": {
      "$type": "dimension",
      "$value": "2rem"
    },
    "h3": {
      "$type": "dimension",
      "$value": "1.5rem"
    },
    "bodyLarge": {
      "$type": "dimension",
      "$value": "1.25rem"
    },
    "body": {
      "$type": "dimension",
      "$value": "1.125rem"
    },
    "caption": {
      "$type": "dimension",
      "$value": "0.875rem"
    },
    "label": {
      "$type": "dimension",
      "$value": "0.875rem"
    }
  },
  "fontWeight": {
    "regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "lineHeight": {
    "tight": {
      "$type": "number",
      "$value": 1.1
    },
    "heading": {
      "$type": "number",
      "$value": 1.2
    },
    "body": {
      "$type": "number",
      "$value": 1.6
    }
  },
  "letterSpacing": {
    "normal": {
      "$type": "dimension",
      "$value": "0em"
    },
    "tight": {
      "$type": "dimension",
      "$value": "-0.025em"
    },
    "display": {
      "$type": "dimension",
      "$value": "-0.045em"
    },
    "wide": {
      "$type": "dimension",
      "$value": "0.08em"
    }
  }
}
