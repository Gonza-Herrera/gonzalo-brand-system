{
  "name": "angular-design-system",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "tokens:validate": "node scripts/tokens.mjs validate",
    "tokens:generate": "node scripts/tokens.mjs generate",
    "tokens:check": "node scripts/tokens.mjs check",
    "prestart": "npm run tokens:check && npm run build:library",
    "start": "ng serve showcase",
    "build": "npm run tokens:check && npm run build:library && npm run build:showcase",
    "build:library": "ng build gh-design-system",
    "build:showcase": "ng build showcase",
    "watch:library": "ng build gh-design-system --watch --configuration development",
    "watch:showcase": "ng build showcase --watch --configuration development",
    "prestorybook": "npm run tokens:check && npm run build:library",
    "storybook": "ng run gh-design-system:storybook",
    "prebuild-storybook": "npm run tokens:check && npm run build:library",
    "build-storybook": "ng run gh-design-system:build-storybook",
    "test-storybook": "test-storybook --ci --failOnConsole",
    "pretest": "npm run tokens:check && npm run build:library",
    "test": "ng test gh-design-system --watch=false && ng test showcase --watch=false"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.19",
    "@angular/animations": "^21.2.18",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@compodoc/compodoc": "^1.2.1",
    "@storybook/addon-a11y": "^10.5.2",
    "@storybook/addon-docs": "^10.5.2",
    "@storybook/angular": "^10.5.2",
    "@storybook/test-runner": "^0.24.4",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "storybook": "^10.5.2",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "zone.js": "^0.16.2"
  }
}
